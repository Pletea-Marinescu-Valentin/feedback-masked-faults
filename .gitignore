# Data: never committed; fetched by scripts/download/ with SHA-256 checks
/data/

# Results: regenerated by experiments/; only small final tables are tracked
/results/*
!/results/tables/

# Large and binary data formats
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.gz
*.parquet
*.feather
*.h5
*.hdf5
*.nc
*.npy
*.npz
*.pkl
*.pickle
*.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.spl
paper/*.synctex.gz
paper/*.pdf

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
